# Copy to .env.local and adjust. Both values fall back to the deployed
# services when unset.

# Base URL of the REST API
VITE_API_BASE_URL=https://sudormrf.pythonanywhere.com

# Socket.IO signalling server used for video calls
# (use http://localhost:8000 when running backend/ locally)
VITE_SOCKET_URL=https://raahi-socket.onrender.com/
